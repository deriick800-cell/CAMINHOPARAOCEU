
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Caminho Para o Céu — Sua Jornada de Fé e Propósito</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Arial', sans-serif;
            line-height: 1.8;
            color: #333;
            background: linear-gradient(180deg, #f8f4e9 0%, #fff9ee 100%);
        }

        /* === CABEÇALHO E NAVEGAÇÃO === */
        header {
            background: linear-gradient(180deg, #1a3050 0%, #2a4a70 100%);
            padding: 15px 5%;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 15px rgba(0,0,0,0.2);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            color: #ffd700;
            font-size: 1.8rem;
            font-weight: bold;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo span {
            color: #fff;
            font-size: 0.9rem;
            font-weight: normal;
            display: block;
        }

        nav {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        nav a {
            color: #fff;
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #ffd700;
        }

        /* === BANNER PRINCIPAL === */
        .banner {
            position: relative;
            width: 100%;
            min-height: 85vh;
            background: url('https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 60px 20px;
        }

        .banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(26, 48, 80, 0.7) 0%, rgba(0,0,0,0.6) 100%);
        }

        .banner-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
        }

        .banner h1 {
            font-size: clamp(2.3rem, 6vw, 4.5rem);
            color: #fff;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.6), 0 4px 15px rgba(0,0,0,0.7);
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        .banner h1 span {
            color: #ffd700;
        }

        .banner p {
            font-size: clamp(1rem, 2.5vw, 1.4rem);
            color: #f8f4e9;
            max-width: 700px;
            margin: 0 auto 30px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }

        .banner-btn {
            padding: 15px 40px;
            font-size: 1.1rem;
            background: linear-gradient(180deg, #ffd700, #d4a020);
            border: none;
            border-radius: 50px;
            color: #1a3050;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .banner-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.6);
        }

        /* === SEÇÕES GERAIS === */
        section {
            padding: 70px 5%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-size: 2.2rem;
            color: #1a3050;
            margin-bottom: 50px;
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #ffd700, #d4a020);
            margin: 15px auto 0;
            border-radius: 2px;
        }

        /* === VERSÍCULO DESTAQUE === */
        .verse-feature {
            background: linear-gradient(135deg, #1a3050 0%, #2a4a70 100%);
            color: #fff;
            padding: 50px 30px;
            border-radius: 15px;
            text-align: center;
            margin: 20px 0;
            box-shadow: 0 8px 30px rgba(26, 48, 80, 0.3);
        }

        .verse-feature p {
            font-size: 1.3rem;
            font-style: italic;
            line-height: 1.8;
            margin-bottom: 15px;
        }

        .verse-feature cite {
            color: #ffd700;
            font-size: 1.1rem;
            font-style: normal;
            font-weight: 600;
        }

        /* === SOBRE NÓS === */
        .about-content {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 50px;
            align-items: center;
        }

        .about-text h3 {
            color: #1a3050;
            font-size: 1.6rem;
            margin-bottom: 20px;
        }

        .about-text p {
            margin-bottom: 20px;
            font-size: 1.05rem;
            color: #444;
        }

        .about-image {
            background: linear-gradient(135deg, #1a3050, #2a4a70);
            color: #fff;
            border-radius: 15px;
            padding: 50px 30px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .about-image .icon-big {
            font-size: 4rem;
            margin-bottom: 15px;
        }

        /* === CAMINHO DA FÉ === */
        .path-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .path-card {
            background: #fff;
            padding: 35px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: transform 0.3s;
            border-top: 4px solid #ffd700;
        }

        .path-card:hover {
            transform: translateY(-8px);
        }

        .path-card .icon {
            font-size: 2.8rem;
            margin-bottom: 20px;
        }

        .path-card h3 {
            color: #1a3050;
            margin-bottom: 15px;
            font-size: 1.3rem;
        }

        .path-card p {
            color: #666;
            font-size: 0.95rem;
        }

        /* === CONTATO === */
        .contact-section {
            background: #fff;
            border-radius: 15px;
            padding: 50px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.06);
        }

        .contact-form {
            max-width: 600px;
            margin: 0 auto;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 14px 18px;
            margin-bottom: 20px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
            font-family: inherit;
            transition: border-color 0.3s;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            outline: none;
            border-color: #ffd700;
        }

        .contact-form button {
            width: 100%;
            padding: 15px;
            background: linear-gradient(180deg, #1a3050, #2a4a70);
            color: #ffd700;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }

        .contact-form button:hover {
            background: linear-gradient(180deg, #2a4a70, #3a5a80);
        }

        /* === RODAPÉ === */
        footer {
            background: #1a3050;
            color: #fff;
            padding: 50px 5% 20px;
            text-align: center;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 25px;
            margin-bottom: 30px;
        }

        .footer-links a {
            color: #ccc;
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: #ffd700;
        }

        .footer-versicle {
            color: #ffd700;
            font-style: italic;
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

        .copyright {
            border-top: 1px solid #334;
            padding-top: 20px;
            color: #888;
            font-size: 0.9rem;
        }

        /* === RESPONSIVIDADE === */
        @media (max-width: 768px) {
            .about-content {
                grid-template-columns: 1fr;
            }

            nav {
                width: 100%;
                justify-content: center;
                margin-top: 15px;
            }

            .verse-feature p {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>

<!-- ====================================== -->
<!-- 🔝 CABEÇALHO / MENU -->
<!-- ====================================== -->
<header>
    <div class="nav-container">
        <a href="#" class="logo">
            ✝ Caminho Para o Céu
            <span>Empresa & Conteúdo Espiritual</span>
        </a>
        <nav>
            <a href="#inicio">Início</a>
            <a href="#sobre">Sobre</a>
            <a href="#caminho">O Caminho</a>
            <a href="#palavra">Palavra</a>
            <a href="#contato">Contato</a>
        </nav>
    </div>
</header>

<!-- ====================================== -->
<!-- 🖼️ BANNER PRINCIPAL -->
<!-- ====================================== -->
<section class="banner" id="inicio">
    <div class="banner-overlay"></div>
    <div class="banner-content">
        <h1>Caminho Para o <span>Céu</span></h1>
        <p>"Eu sou o caminho, a verdade e a vida. Ninguém vem ao Pai, senão por mim." — João 14:6</p>
        <a href="#sobre" class="banner-btn">Começar a Jornada ✨</a>
    </div>
</section>

<!-- ====================================== -->
<!-- 📖 VERSÍCULO DESTAQUE -->
<!-- ====================================== -->
<section>
    <div class="verse-feature">
        <p>"Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo aquele que nele crer não pereça, mas tenha a vida eterna."</p>
        <cite>— João 3:16</cite>
    </div>
</section>

<!-- ====================================== -->
<!-- 🙏 SOBRE NÓS -->
<!-- ====================================== -->
<section id="sobre">
    <h2 class="section-title">Sobre Nós</h2>
    <div class="about-content">
        <div class="about-text">
            <h3>Proclamar a Verdade de Cristo com Excelência</h3>
            <p>Bem-vindo ao <strong>Caminho Para o Céu</strong>. Somos uma organização focada em inspirar vidas, guiando pessoas através de princípios elevados, edificação espiritual e conteúdos baseados inteiramente na Palavra de Deus.</p>
            <p>A nossa missão é apontar para Jesus, pois Ele é o único caminho autêntico para a paz e a salvação eterna. Como está escrito: <em>"Nem há salvação em nenhum outro, porque debaixo do céu não há nenhum outro nome dado aos homens pelo qual devamos ser salvos."</em> — Atos 4:12</p>
            <p>Trabalhamos diariamente para levar mensagens de fé, esperança e transformação a todas as famílias.</p>
        </div>
        <div class="about-image">
            <div class="icon-big">📖</div>
            <h4 style="color: #ffd700; margin-bottom: 10px;">Valores & Princípios</h4>
            <p style="font-size: 0.95rem; color: #ddd;">Amor, integridade, dedicação e compromisso inabalável com a verdade bíblica.</p>
        </div>
    </div>
</section>

<!-- ====================================== -->
<!-- ⛪ O CAMINHO DA FÉ -->
<!-- ====================================== -->
<section id="caminho">
    <h2 class="section-title">O Caminho da Fé</h2>
    <div class="path-grid">
        <div class="path-card">
            <div class="icon">🙏</div>
            <h3>Arrependimento</h3>
            <p>"Assim, pois, arrependei-vos e convertei-vos, para que sejam apagados os vossos pecados."<br><strong>— Atos 3:19</strong></p>
        </div>
        <div class="path-card">
            <div class="icon">✝️</div>
            <h3>Fé em Cristo</h3>
            <p>"Mas a todos quantos o receberam, deu-lhes o poder de serem feitos filhos de Deus..."<br><strong>— João 1:12</strong></p>
        </div>
        <div class="path-card">
            <div class="icon">💧</div>
            <h3>Batismo</h3>
            <p>"Portanto, ide, ensinai todas as nações, batizando-as em nome do Pai, e do Filho..."<br><strong>— Mateus 28:19</strong></p>
        </div>
        <div class="path-card">
            <div class="icon">🕊️</div>
            <h3>Vida Santa</h3>
            <p>"Sede santos, porque eu sou santo, diz o Senhor."<br><strong>— 1 Pedro 1:16</strong></p>
        </div>
        <div class="path-card">
            <div class="icon">📖</div>
            <h3>Ler a Palavra</h3>
            <p>"Lâmpada para os meus pés é a tua palavra e luz para o meu caminho."<br><strong>— Salmo 119:105</strong></p>
        </div>
        <div class="path-card">
            <div class="icon">🛐</div>
            <h3>Oração</h3>
            <p>"Orai sem cessar."<br><strong>— 1 Tessalonicenses 5:17</strong></p>
        </div>
    </div>
</section>

<!-- ====================================== -->
<!-- 📜 PALAVRA DE DESTAQUE -->
<!-- ====================================== -->
<section id="palavra">
    <h2 class="section-title">A Palavra de Deus</h2>
    <div class="verse-feature">
        <p>"Porque a palavra de Deus é viva, e eficaz, e mais penetrante do que qualquer espada de dois gumes, e penetra até à divisão da alma e do espírito..."</p>
        <cite>— Hebreus 4:12</cite>
    </div>
    <div style="text-align: center; margin-top: 30px;">
        <p style="font-size: 1.1rem; color: #555; max-width: 800px; margin: 0 auto;">
            Que a graça de nosso Senhor Jesus Cristo, o amor de Deus Pai e a comunhão do Espírito Santo estejam com todos vós.
        </p>
        <p style="margin-top: 15px; color: #1a3050; font-weight: bold;">— 2 Coríntios 13:14</p>
    </div>
</section>

<!-- ====================================== -->
<!-- ✉️ CONTATO -->
<!-- ====================================== -->
<section id="contato">
    <h2 class="section-title">Fale Conosco</h2>
    <div class="contact-section">
        <form class="contact-form" onsubmit="event.preventDefault(); alert('🙏 Obrigado pela sua mensagem! Entraremos em contacto em breve.');">
            <input type="text" placeholder="O seu nome" required>
            <input type="email" placeholder="O seu e-mail" required>
            <textarea rows="5" placeholder="A sua mensagem, dúvida ou pedido de oração..."></textarea>
            <button type="submit">Enviar Mensagem ✝️</button>
        </form>
    </div>
</section>

<!-- ====================================== -->
<!-- 📌 RODAPÉ -->
<!-- ====================================== -->
<footer>
    <div class="footer-content">
        <h3 style="color: #ffd700; font-size: 1.5rem; margin-bottom: 15px;">✝ Caminho Para o Céu</h3>
        <p class="footer-versicle">"Buscai primeiro o reino de Deus e a sua justiça, e todas estas coisas vos serão acrescentadas." — Mateus 6:33</p>
        
        <div class="footer-links">
            <a href="#inicio">Início</a>
            <a href="#sobre">Sobre</a>
            <a href="#caminho">O Caminho</a>
            <a href="#palavra">Palavra</a>
            <a href="#contato">Contato</a>
        </div>
        
        <p class="copyright">
            © 2026 Caminho Para o Céu — Todos os direitos reservados<br>
            📖 Baseado na Bíblia Sagrada — "A palavra do Senhor permanece para sempre." — 1 Pedro 1:25
        </p>
    </div>
</footer>

<script>
// Scroll suave para os links de navegação
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        const targetElement = document.querySelector(targetId);
if (targetElement) 
{ 
window.scrollTo({
top: targetElement.offsetTop - 60,
behavior: 'smooth'
   });
  }
 });
});
</script>

</body>
</html>
